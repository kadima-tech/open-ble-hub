{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kadima-tech/openble/releases/download/catalog-v1/schema.json",
  "title": "OpenBLE protocol catalog v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "const": "https://github.com/kadima-tech/openble"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "issuesIncluded": {
      "type": "boolean"
    },
    "protocols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publishedProtocol"
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "repository",
    "revision",
    "generatedAt",
    "issuesIncluded",
    "protocols"
  ],
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tested": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limits": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "package": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^openble-[a-z0-9-]+$"
        },
        "manual": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)[^\\\\:?#%]+$"
        },
        "extraManual": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 1
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "issueLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "brand": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "verified",
                  "reported",
                  "documented",
                  "planned",
                  "unsupported"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "firmware": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "platform": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)[^\\\\:?#%]+$"
                    }
                  },
                  "required": [
                    "title",
                    "path"
                  ]
                },
                "minItems": 1
              },
              "issueLabels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "maxItems": 1
              }
            },
            "required": [
              "id",
              "brand",
              "model",
              "status",
              "notes",
              "firmware",
              "platform",
              "evidence",
              "issueLabels"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "type",
        "summary",
        "description",
        "tested",
        "limits",
        "next",
        "id",
        "package",
        "manual",
        "code",
        "capabilities",
        "integrations",
        "issueLabels",
        "devices"
      ]
    },
    "publishedProtocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tested": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limits": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "package": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^openble-[a-z0-9-]+$"
        },
        "manual": {
          "type": "string",
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)[^\\\\:?#%]+$"
        },
        "extraManual": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 1
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "issueLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "brand": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "status": {
                "enum": [
                  "verified",
                  "reported",
                  "documented",
                  "planned",
                  "unsupported"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "firmware": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "platform": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)[^\\\\:?#%]+$"
                    }
                  },
                  "required": [
                    "title",
                    "path"
                  ]
                },
                "minItems": 1
              },
              "issueLabels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "minItems": 1,
                "maxItems": 1
              }
            },
            "required": [
              "id",
              "brand",
              "model",
              "status",
              "notes",
              "firmware",
              "platform",
              "evidence",
              "issueLabels"
            ]
          },
          "minItems": 1
        },
        "library": {
          "type": "boolean"
        },
        "packageMetadata": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "python": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sourcePath": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)[^\\\\:?#%]+$"
                }
              },
              "required": [
                "version",
                "python",
                "sourcePath"
              ]
            }
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Untrusted, user-controlled issue title. Render as plain text with output-context escaping; never interpret as HTML."
              },
              "state": {
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "url": {
                "type": "string",
                "pattern": "^https://github\\.com/kadima-tech/openble/issues/[1-9][0-9]*$"
              },
              "deviceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "number",
              "title",
              "state",
              "url",
              "deviceIds"
            ]
          }
        }
      },
      "required": [
        "name",
        "type",
        "summary",
        "description",
        "tested",
        "limits",
        "next",
        "id",
        "package",
        "manual",
        "code",
        "capabilities",
        "integrations",
        "issueLabels",
        "devices",
        "library",
        "packageMetadata",
        "issues"
      ]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "verified",
            "reported",
            "documented",
            "planned",
            "unsupported"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "firmware": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[/]$)[^\\\\:?#%]+$"
              }
            },
            "required": [
              "title",
              "path"
            ]
          },
          "minItems": 1
        },
        "issueLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "id",
        "brand",
        "model",
        "status",
        "notes",
        "firmware",
        "platform",
        "evidence",
        "issueLabels"
      ]
    }
  }
}
