[Unit]
Description=Philips BLE Hub (DL8780 scale to Google Health)
After=bluetooth.service network-online.target
Wants=bluetooth.service network-online.target

[Service]
User=philips-ble-hub
Group=philips-ble-hub
SupplementaryGroups=bluetooth
WorkingDirectory=/opt/philips-ble-hub
ExecStart=/opt/philips-ble-hub/.venv/bin/python -m ble_hub --data-dir /var/lib/philips-ble-hub --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/philips-ble-hub
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
