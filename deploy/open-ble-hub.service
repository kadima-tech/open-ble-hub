[Unit]
Description=Open BLE Hub (Bluetooth health devices to Google Health)
After=bluetooth.service network-online.target
Wants=bluetooth.service network-online.target

[Service]
User=open-ble-hub
Group=open-ble-hub
SupplementaryGroups=bluetooth
WorkingDirectory=/opt/open-ble-hub
ExecStart=/opt/open-ble-hub/.venv/bin/python -m ble_hub --data-dir /var/lib/open-ble-hub --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/open-ble-hub
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
